# The WSL entrypoint must use Unix line endings even when Git for Windows
# or Windows-native editors otherwise default to CRLF.
# A CRLF shebang makes ./tt fail with: env: 'bash\r': No such file.
tt text eol=lf
*.sh text eol=lf

# Keep code and documentation predictable across Windows editors and WSL.
*.py text eol=lf
*.md text eol=lf
VERSION text eol=lf
